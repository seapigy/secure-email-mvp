# Secure Email MVP - Environment Configuration
# Copy this file to .env and fill in your actual credentials

# =============================================================================
# CLOUDFLARE R2 STORAGE CONFIGURATION
# =============================================================================
# Cloudflare R2 is used for storing encrypted email content
CLOUDFLARE_R2_ACCESS_KEY=your_access_key_id_here
CLOUDFLARE_R2_SECRET_KEY=your_secret_access_key_here
CLOUDFLARE_R2_BUCKET=secure-email-blobs
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_REGION=auto

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# SQLite database path (default: /var/db/secure-email.db)
SQLITE_DB=/var/db/secure-email.db

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# Generate a secure 32-byte secret: openssl rand -base64 32
JWT_SECRET=your_32_byte_jwt_secret_here

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# API server host and port
API_HOST=api.securesystem.email
API_PORT=8080

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log file path
LOG_FILE=/var/log/api.log

# =============================================================================
# RATE LIMITING
# =============================================================================
# Rate limiting configuration (requests per minute per IP)
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60

# =============================================================================
# DEBUG MODE
# =============================================================================
# Set to true for development, false for production
DEBUG=false

# =============================================================================
# FRONTEND CONFIGURATION (for Vite)
# =============================================================================
# API host for frontend (used in src/lib/api.ts)
VITE_API_HOST=https://api.securesystem.email

# =============================================================================
# IP REPUTATION SERVICE CONFIGURATION
# =============================================================================
# AbuseIPDB API key for IP reputation checking (free tier available)
# Get your key at: https://www.abuseipdb.com/api
IP_REPUTATION_API_KEY=your_abuseipdb_api_key_here

# Malicious threshold (0-100, default: 25)
# Higher values are more permissive, lower values are more restrictive
IP_REPUTATION_THRESHOLD=25

# =============================================================================
# PASSWORD VALIDATION & BREACH CHECK CONFIGURATION
# =============================================================================
# HaveIBeenPwned API key for password breach checking (free tier available)
# Get your key at: https://haveibeenpwned.com/API/Key
# Note: The Pwned Passwords API uses k-anonymity and doesn't require an API key
# but having one increases rate limits
HIBP_API_KEY=your_hibp_api_key_here

# =============================================================================
# USER ACCOUNT LOCKOUT CONFIGURATION (Micro-Iteration 4.6)
# =============================================================================
# Enable/disable account lockout after failed login attempts
# Set to 1 to enable, 0 or unset to disable
LOGIN_RATE_LIMIT_ENABLED=1

# Maximum failed login attempts before account lockout (default: 5)
LOGIN_MAX_ATTEMPTS=5

# Lockout duration in minutes (default: 30)
LOGIN_LOCKOUT_MINUTES=30

# Time window in minutes for counting failed attempts (default: 15)
# After this window expires, failed attempts are reset
LOGIN_ATTEMPT_WINDOW_MINUTES=15

# =============================================================================
# EMAIL RETENTION & CLEANUP CONFIGURATION (Micro-Iteration 4.24)
# =============================================================================
# Default expiration time for new emails in days (default: 30)
DEFAULT_EMAIL_EXPIRATION_DAYS=30

# Whether to delete audit logs when cleaning up emails (default: false)
# Set to true to remove audit logs along with deleted emails
CLEANUP_AUDIT_LOGS=false

# Whether to enable notifications/logging for removed emails (default: true)
# Set to false to disable cleanup notifications
ENABLE_CLEANUP_NOTIFICATIONS=true

# Number of emails to process in each cleanup batch (default: 100)
# Higher values may improve performance but use more memory
CLEANUP_BATCH_SIZE=100

# =============================================================================
# EMAIL RETENTION NOTIFICATIONS & ANALYTICS CONFIGURATION (Micro-Iteration 4.25)
# =============================================================================
# Enable expiration notifications to senders (default: true)
# Notify senders when their emails are about to expire
ENABLE_EXPIRATION_NOTIFICATIONS=true

# Advance notice period for expiration notifications in hours (default: 24)
# Send notifications this many hours before email expiration
EXPIRATION_ADVANCE_NOTICE_HOURS=24

# Enable cleanup notifications to senders (default: false)
# Notify senders when their emails are deleted by auto-cleanup
ENABLE_CLEANUP_NOTIFICATIONS_SENDER=false

# Email template for retention notifications (default: simple text)
# Can be customized for branding and styling
RETENTION_NOTIFICATION_EMAIL_TEMPLATE=Your email {email_id} will expire in {hours} hours. Please take action if needed.

# Analytics cache duration in minutes (default: 60)
# How long to cache analytics results to improve performance
ANALYTICS_CACHE_DURATION_MINUTES=60

# Maximum number of analytics records to return (default: 1000)
# Limit for pagination and performance
ANALYTICS_MAX_RECORDS=1000

# =============================================================================
# SMART RETENTION POLICY & ARCHIVAL CONFIGURATION (Micro-Iteration 4.26)
# =============================================================================
# Default retention days when no policy matches (default: 30)
# How long to keep emails before deletion/archival
DEFAULT_RETENTION_DAYS=30

# Default archival retention days (default: 365)
# How long to keep archived emails before permanent deletion
DEFAULT_ARCHIVE_RETENTION_DAYS=365

# Default archival behavior (default: false)
# Whether to archive emails instead of deleting them by default
DEFAULT_ARCHIVE_INSTEAD=false

# Archive cleanup interval in hours (default: 24)
# How often to run cleanup of expired archives
ARCHIVE_CLEANUP_INTERVAL_HOURS=24

# Archive batch size for cleanup operations (default: 50)
# Number of archives to process in each cleanup batch
ARCHIVE_CLEANUP_BATCH_SIZE=50

# Enable policy evaluation logging (default: true)
# Log policy evaluation results for debugging and analytics
ENABLE_POLICY_EVALUATION_LOGGING=true

# Policy evaluation log retention days (default: 30)
# How long to keep policy evaluation logs
POLICY_EVALUATION_LOG_RETENTION_DAYS=30

# Archive operation log retention days (default: 90)
# How long to keep archive operation logs
ARCHIVE_OPERATION_LOG_RETENTION_DAYS=90

# =============================================================================
# INTELLIGENT RETENTION INSIGHTS & RECOMMENDATIONS CONFIGURATION (Micro-Iteration 4.27)
# =============================================================================
# Enable retention insights generation (default: true)
# Generate daily insights and analytics for retention policies
ENABLE_RETENTION_INSIGHTS=true

# =============================================================================
# PREDICTIVE RETENTION FORECASTING & ANOMALY DETECTION CONFIGURATION (Micro-Iteration 4.29)
# =============================================================================
# Enable retention forecasting (default: true)
# Generate predictive forecasts for storage usage and policy impact
ENABLE_RETENTION_FORECASTING=true

# Enable retention anomaly detection (default: true)
# Detect unusual retention and archival activity patterns
ENABLE_RETENTION_ANOMALY_DETECTION=true

# Forecast periods in days (default: 7,30,90)
# Time horizons for predictive forecasting
FORECAST_PERIODS_DAYS=7,30,90

# Forecast confidence threshold (default: 0.8)
# Minimum confidence score for forecasts to be considered reliable
FORECAST_CONFIDENCE_THRESHOLD=0.8

# Anomaly detection window in hours (default: 24)
# Time window for anomaly detection analysis
ANOMALY_DETECTION_WINDOW_HOURS=24

# Spike deletion threshold percentage (default: 200.0)
# Percentage increase in deletions to trigger anomaly
SPIKE_DELETION_THRESHOLD=200.0

# Drop policy matches threshold percentage (default: 50.0)
# Percentage decrease in policy matches to trigger anomaly
DROP_POLICY_MATCHES_THRESHOLD=50.0

# Forecast deviation threshold percentage (default: 25.0)
# Percentage deviation from forecast to trigger anomaly
FORECAST_DEVIATION_THRESHOLD=25.0

# Unusual archival threshold percentage (default: 150.0)
# Percentage increase in archival operations to trigger anomaly
UNUSUAL_ARCHIVAL_THRESHOLD=150.0

# Auto resolution enabled (default: false)
# Whether to enable automatic anomaly resolution
AUTO_RESOLUTION_ENABLED=false

# Cost per GB per month for cost calculations (default: 0.02)
# Used for calculating storage cost savings in forecasts
COST_PER_GB_PER_MONTH=0.02

# =============================================================================
# AUTOMATED COMPLIANCE & RETENTION CERTIFICATION CONFIGURATION (Micro-Iteration 4.30)
# =============================================================================
# Enable enterprise compliance features (default: false)
# Enables enterprise organization management and compliance frameworks
ENABLE_ENTERPRISE_COMPLIANCE=false

# Enable automated compliance reporting (default: true)
# Enables automatic generation of compliance certifications and reports
ENABLE_AUTOMATED_COMPLIANCE_REPORTING=true

# Enable compliance violation detection (default: true)
# Enables automatic detection of compliance violations
ENABLE_COMPLIANCE_VIOLATION_DETECTION=true

# Compliance reporting interval in hours (default: 24)
# How often to generate compliance reports
COMPLIANCE_REPORTING_INTERVAL_HOURS=24

# Compliance violation detection interval in hours (default: 1)
# How often to check for compliance violations
COMPLIANCE_VIOLATION_DETECTION_INTERVAL_HOURS=1

# Auto-enforcement of compliance rules (default: true)
# Whether to automatically enforce compliance rules
ENABLE_COMPLIANCE_AUTO_ENFORCEMENT=true

# Compliance certification retention days (default: 2555)
# How long to retain compliance certifications
COMPLIANCE_CERTIFICATION_RETENTION_DAYS=2555

# Compliance audit log retention days (default: 730)
# How long to retain compliance audit logs
COMPLIANCE_AUDIT_LOG_RETENTION_DAYS=730

# Compliance violation retention days (default: 365)
# How long to retain resolved compliance violations
COMPLIANCE_VIOLATION_RETENTION_DAYS=365

# Enable policy recommendations (default: true)
# Generate proactive policy recommendations based on usage patterns
ENABLE_POLICY_RECOMMENDATIONS=true

# Insights rollup interval in hours (default: 24)
# How often to generate daily insights rollups
INSIGHTS_ROLLUP_INTERVAL_HOURS=24

# Recommendation generation interval in hours (default: 168 - weekly)
# How often to generate new policy recommendations
RECOMMENDATION_GENERATION_INTERVAL_HOURS=168

# Recommendation apply batch size (default: 50)
# Number of recommendations to process in each batch
RECOMMENDATION_APPLY_BATCH_SIZE=50

# Maximum impact score for recommendations (default: 0.9)
# Only apply recommendations with impact score below this threshold
RECOMMENDATION_MAX_IMPACT_SCORE=0.9

# =============================================================================
# REAL-TIME MONITORING & ADAPTIVE POLICY ENFORCEMENT CONFIGURATION (Micro-Iteration 4.28)
# =============================================================================
# Enable real-time retention monitoring (default: true)
# Monitor retention operations in real-time with in-memory cache
ENABLE_REALTIME_RETENTION_MONITORING=true

# Enable adaptive policy enforcement (default: false)
# Automatically adjust policy parameters based on live metrics
ENABLE_ADAPTIVE_POLICY_ENFORCEMENT=false

# Adaptive policy cooldown period in days (default: 7)
# Minimum time between adaptive policy changes
ADAPTIVE_POLICY_COOLDOWN_DAYS=7

# Adaptive policy change threshold percentage (default: 10.0)
# Minimum percentage change required to trigger adaptive policy updates
ADAPTIVE_POLICY_CHANGE_THRESHOLD=10.0

# Real-time metrics cache TTL in seconds (default: 300)
# How long to cache real-time metrics in memory
REALTIME_METRICS_CACHE_TTL_SECONDS=300

# Real-time monitoring batch size (default: 100)
# Number of operations to process in each monitoring batch
REALTIME_MONITORING_BATCH_SIZE=100

# =============================================================================
# AMAZON SES SMTP CONFIGURATION (Postfix Relay)
# =============================================================================
# Amazon SES SMTP credentials for Postfix relay configuration
# These credentials are used by Postfix to relay outgoing emails through SES
# 
# To get these credentials:
# 1. Go to AWS SES Console > SMTP Settings
# 2. Create SMTP credentials (different from AWS access keys)
# 3. Note the SMTP endpoint and credentials
SES_SMTP_USERNAME=your_ses_smtp_username_here
SES_SMTP_PASSWORD=your_ses_smtp_password_here
SES_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_REGION=us-east-1

# SES sending limits and configuration
# Maximum sending rate per second (default: 14 for SES sandbox, 50+ for production)
SES_SMTP_RATE_LIMIT=14

# Whether to use SES in sandbox mode (default: true)
# In sandbox mode, you can only send to verified email addresses
SES_SMTP_SANDBOX_MODE=true

# Default sender email address for system notifications
# Must be verified in SES if in sandbox mode
SES_DEFAULT_SENDER=noreply@securesystem.email

# =============================================================================
# USER TRANSPARENCY LAYER CONFIGURATION (Micro-Iteration 4.31)
# =============================================================================
# Enable user compliance portal (default: false)
# Allows users to view their own compliance status and policies
ENABLE_USER_COMPLIANCE_PORTAL=false

# Show retention rules to users (default: true)
# Whether users can see retention policies that apply to them
USER_COMPLIANCE_SHOW_RETENTION_RULES=true

# Show compliance frameworks to users (default: true)
# Whether users can see compliance frameworks their organization is enrolled in
USER_COMPLIANCE_SHOW_FRAMEWORKS=true

# Show violations to users (default: false)
# Whether users can see their own compliance violations (privacy-sensitive)
USER_COMPLIANCE_SHOW_VIOLATIONS=false

# Show compliance rules to users (default: true)
# Whether users can see specific compliance rules that apply to their policies
USER_COMPLIANCE_SHOW_COMPLIANCE_RULES=true

# User compliance cache TTL in minutes (default: 15)
# How long to cache user compliance data for performance
USER_COMPLIANCE_CACHE_TTL_MINUTES=15 