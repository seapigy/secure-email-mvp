#!/usr/bin/env bash
# Pre-push hook to warn about website changes
# This hook warns developers if they're pushing changes to the website/ directory
# without proper approval markers

set -e

# Colors for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

echo "🔍 Checking for website changes..."

# Get the remote and branch being pushed to
remote="$1"
url="$2"

# Get the list of commits being pushed
while read local_ref local_sha remote_ref remote_sha; do
    # Skip if this is a delete operation
    if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
        continue
    fi
    
    # Get the list of files changed in this push
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        # New branch
        changed_files=$(git diff --name-only --diff-filter=AM $local_sha^..$local_sha)
    else
        # Update to existing branch
        changed_files=$(git diff --name-only --diff-filter=AM $remote_sha..$local_sha)
    fi
    
    # Check if any website files are being changed
    website_changes=$(echo "$changed_files" | grep "^website/" || true)
    
    if [ -n "$website_changes" ]; then
        echo ""
        echo -e "${RED}🚨 WARNING: Website changes detected!${NC}"
        echo -e "${YELLOW}The following website files are being modified:${NC}"
        echo "$website_changes" | sed 's/^/  - /'
        echo ""
        
        # Check if this is an approved website edit branch
        if echo "$remote_ref" | grep -q "website-edit/"; then
            echo -e "${GREEN}✅ Detected website-edit/ branch - checking for approval marker...${NC}"
            
            # Check if commit message contains approval marker
            commit_message=$(git log --format=%B -n 1 $local_sha)
            if echo "$commit_message" | grep -q "WEBSITE-EDIT-APPROVED:"; then
                echo -e "${GREEN}✅ Approval marker found in commit message${NC}"
                echo -e "${GREEN}✅ Proceeding with push...${NC}"
            else
                echo -e "${RED}❌ No approval marker found in commit message${NC}"
                echo -e "${YELLOW}Required format: WEBSITE-EDIT-APPROVED: <JIRA/PR-ID>${NC}"
                echo ""
                echo -e "${RED}Push blocked. Please:${NC}"
                echo "1. Ensure your branch name starts with 'website-edit/'"
                echo "2. Include 'WEBSITE-EDIT-APPROVED: <ID>' in your commit message"
                echo "3. Or get the 'website-edit-approved' label on your PR"
                exit 1
            fi
        else
            echo -e "${RED}❌ Website changes detected without proper approval${NC}"
            echo ""
            echo -e "${YELLOW}To push website changes, you must:${NC}"
            echo "1. Create a branch starting with 'website-edit/'"
            echo "2. Include 'WEBSITE-EDIT-APPROVED: <JIRA/PR-ID>' in commit message"
            echo "3. Or get the 'website-edit-approved' label on your PR"
            echo ""
            echo -e "${YELLOW}For more information, see:${NC}"
            echo "- WEBSITE_FREEZE_POLICY.md"
            echo "- website/FROZEN.md"
            echo "- .github/ISSUE_TEMPLATE/website-change-request.md"
            echo ""
            echo -e "${RED}Push blocked to prevent unauthorized website changes.${NC}"
            exit 1
        fi
    fi
done

echo -e "${GREEN}✅ No website changes detected - proceeding with push${NC}"
exit 0
